# Supabase Postgres. Copy to .env and paste the connection string from
# Supabase Dashboard -> Connect -> "Transaction pooler" (port 6543), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Auth. Use the existing project's URL and publishable (or anon) key.
# Never put a service-role/secret key in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
